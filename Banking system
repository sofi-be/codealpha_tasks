#include <stdio.h>
#include <stdlib.h>

#define FILE_NAME "bank.dat"


struct Account
{
    int accountNumber;
    char name[50];
    float balance;
};


/* Function declarations */
void createAccount(struct Account *account);
void deposit(struct Account *account);
void withdraw(struct Account *account);
void balanceEnquiry(struct Account *account);
void saveAccount(struct Account *account);
int loadAccount(struct Account *account);


int main()
{
    struct Account account;
    int choice;

    /* Try to load existing account */
    if (!loadAccount(&account))
    {
        printf("No account found.\n");
        printf("Let's create a new account.\n");

        createAccount(&account);

        saveAccount(&account);
    }

    while (1)
    {
        printf("\n===== BANKING SYSTEM =====\n");
        printf("1. Deposit\n");
        printf("2. Withdraw\n");
        printf("3. Balance Enquiry\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");

        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                deposit(&account);
                break;

            case 2:
                withdraw(&account);
                break;

            case 3:
                balanceEnquiry(&account);
                break;

            case 4:
                printf("Thank you for using the banking system.\n");
                return 0;

            default:
                printf("Invalid choice!\n");
        }
    }

    return 0;
}


/* CREATE ACCOUNT */
void createAccount(struct Account *account)
{
    printf("\nEnter account number: ");
    scanf("%d", &account->accountNumber);

    printf("Enter account holder name: ");
    scanf(" %49[^\n]", account->name);

    printf("Enter initial balance: ");
    scanf("%f", &account->balance);

    printf("Account created successfully!\n");
}


/* SAVE ACCOUNT */
void saveAccount(struct Account *account)
{
    FILE *file;

    file = fopen(FILE_NAME, "wb");

    if (file == NULL)
    {
        printf("Error opening file!\n");
        return;
    }

    fwrite(account, sizeof(struct Account), 1, file);

    fclose(file);
}


/* LOAD ACCOUNT */
int loadAccount(struct Account *account)
{
    FILE *file;

    file = fopen(FILE_NAME, "rb");

    if (file == NULL)
    {
        return 0;
    }

    fread(account, sizeof(struct Account), 1, file);

    fclose(file);

    return 1;
}


/* DEPOSIT */
void deposit(struct Account *account)
{
    float amount;

    printf("\nEnter amount to deposit: ");
    scanf("%f", &amount);

    if (amount <= 0)
    {
        printf("Amount must be greater than zero.\n");
        return;
    }

    account->balance += amount;

    saveAccount(account);

    printf("Deposit successful!\n");
    printf("New balance: %.2f\n", account->balance);
}


/* WITHDRAW */
void withdraw(struct Account *account)
{
    float amount;

    printf("\nEnter amount to withdraw: ");
    scanf("%f", &amount);

    if (amount <= 0)
    {
        printf("Amount must be greater than zero.\n");
        return;
    }

    if (amount > account->balance)
    {
        printf("Insufficient balance!\n");
        return;
    }

    account->balance -= amount;

    saveAccount(account);

    printf("Withdrawal successful!\n");
    printf("New balance: %.2f\n", account->balance);
}


/* BALANCE ENQUIRY */
void balanceEnquiry(struct Account *account)
{
    printf("\n===== ACCOUNT INFORMATION =====\n");
    printf("Account Number: %d\n", account->accountNumber);
    printf("Account Holder: %s\n", account->name);
    printf("Balance: %.2f\n", account->balance);
}
