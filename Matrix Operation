#include <stdio.h>

void addMatrices(int A[2][2], int B[2][2], int result[2][2])
{
    for (int i = 0; i < 2; i++)
    {
        for (int j = 0; j < 2; j++)
        {
            result[i][j] = A[i][j] + B[i][j];
        }
    }
}

void multiplyMatrices(int A[2][2], int B[2][2], int result[2][2])
{
    for (int i = 0; i < 2; i++)
    {
        for (int j = 0; j < 2; j++)
        {
            result[i][j] = 0;

            for (int k = 0; k < 2; k++)
            {
                result[i][j] += A[i][k] * B[k][j];
            }
        }
    }
}

void transposeMatrix(int matrix[2][2], int result[2][2])
{
    for (int i = 0; i < 2; i++)
    {
        for (int j = 0; j < 2; j++)
        {
            result[i][j] = matrix[j][i];
        }
    }
}

void displayMatrix(int matrix[2][2])
{
    for (int i = 0; i < 2; i++)
    {
        for (int j = 0; j < 2; j++)
        {
            printf("%d ", matrix[i][j]);
        }

        printf("\n");
    }
}

int main()
{
    int A[2][2];
    int B[2][2];
    int result[2][2];

    printf("Enter elements of Matrix A:\n");

    for (int i = 0; i < 2; i++)
    {
        for (int j = 0; j < 2; j++)
        {
            scanf("%d", &A[i][j]);
        }
    }

    printf("Enter elements of Matrix B:\n");

    for (int i = 0; i < 2; i++)
    {
        for (int j = 0; j < 2; j++)
        {
            scanf("%d", &B[i][j]);
        }
    }

    printf("\nMatrix A:\n");
    displayMatrix(A);

    printf("\nMatrix B:\n");
    displayMatrix(B);

    addMatrices(A, B, result);

    printf("\nAddition:\n");
    displayMatrix(result);

    multiplyMatrices(A, B, result);

    printf("\nMultiplication:\n");
    displayMatrix(result);

    transposeMatrix(A, result);

    printf("\nTranspose of Matrix A:\n");
    displayMatrix(result);

    return 0;
}
